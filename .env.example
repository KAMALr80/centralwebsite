# ─────────────────────────────────────────────────────────────────────────────
# Fastweb — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────

# Base URL of the backend REST API (no trailing slash).
# All axios requests are prefixed with this value.
# Example: http://localhost:8000/api or https://api.yourstore.com/api
NEXT_PUBLIC_API_URL=https://nes-gateway.cloud.bbtl.app

# ── Branding ──────────────────────────────────────────────────────────────────

# Company name shown in the NavBar logo and page titles.
NEXT_PUBLIC_COMPANY_NAME=Central Smoke Distro

# Optional: absolute URL to a logo image (PNG/SVG).
# If set, the Logo component will render this image instead of the default SVG mark.
# Leave empty to use the default text/SVG logo.
NEXT_PUBLIC_COMPANY_LOGO_URL=

# ── Images ────────────────────────────────────────────────────────────────────

# URL pattern for the image CDN used by Next.js image optimization.
# Must include protocol and a wildcard path, e.g. https://phynixcloud.com/**
IMAGE_CDN_URL=https://phynixcloud.com/**

# ── Theme ─────────────────────────────────────────────────────────────────────

# Default UI theme on first load. One of: central | pallet
# Users can switch themes at runtime via the ThemeToggle in the nav;
# their choice is persisted to localStorage.
NEXT_PUBLIC_THEME=central
